#!/usr/bin/env python3
import json
import os
import sys
if sys.argv[1:2] == ['models']:
    mode = os.environ.get('FAKE_OPENCODE_CATALOG', '')
    if mode == 'fail':
        sys.exit(1)
    if mode == 'bad':
        print('unexpected format')
    elif mode in ('nullvariant', 'listvariants', 'listmodel'):
        print('test/model')
        print(json.dumps({'variants': {'high': None}} if mode == 'nullvariant' else {'variants': []} if mode == 'listvariants' else []))
    else:
        print('test/model')
        print(json.dumps({'variants': {'low': {}, 'high': {}, 'custom': {}, 'disabled': {'disabled': True}}}))
elif sys.argv[1:3] == ['debug', 'paths']:
    print('state      ' + os.environ['FAKE_OPENCODE_STATE_DIR'])
else:
    from pathlib import Path
    root = Path(os.environ['XDG_STATE_HOME']) / 'opencode'
    print(json.dumps({'argv': sys.argv[1:], 'inline': os.environ.get('OPENCODE_CONFIG_CONTENT'),
                      'state': str(root), 'model': json.loads((root/'model.json').read_text()),
                      'history': (root/'prompt-history.jsonl').read_text() if (root/'prompt-history.jsonl').exists() else None,
                      'kv': (root/'kv.json').read_text() if (root/'kv.json').exists() else None,
                      'locks': (root/'locks').exists()}))
